{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "typescript", "import", "unicorn", "oxc", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "warn",
    "typescript/no-non-null-assertion": "warn",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react/self-closing-comp": "warn",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "no-underscore-dangle": "off",
    "oxc/no-map-spread": "off",
    "import/no-named-as-default-member": "off",
    "react/no-array-index-key": "off",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": "warn",
    "import/no-unassigned-import": "off",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-debugger": "error",
    "unicorn/no-array-sort": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react-native",
            "importNames": [
              "Animated",
              "TouchableOpacity",
              "TouchableHighlight",
              "TouchableWithoutFeedback",
              "TouchableNativeFeedback"
            ],
            "message": "Use the @/ui Pressable wrapper. Legacy Animated is banned — use react-native-reanimated."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["app/**/*.{ts,tsx}"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.{js,cjs,mjs}"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", "ios", "android", ".expo", "dist", "build"]
}
